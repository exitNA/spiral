{
  "description": "Screen project learning on entry and request one bounded final learning pass.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/ethos_hook.py\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& python (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/ethos_hook.py')\"",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/ethos_hook.py\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& python (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/ethos_hook.py')\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
